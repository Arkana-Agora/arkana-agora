// Prisma schema — MINIMAL STUB
// Source of truth: docs/03-database/entities.md (18 entities across 5 domains)
// ADR-002: Prisma only ORM; SQLite dev / PostgreSQL (Neon) prod.
// This stub only bootstraps the ORM; extend models per docs/03-database/entities.md
// and follow the migration discipline in docs/03-database/migrations.md.
// Note: `provider @default(EMAIL)` is a sensible dev default; entities.md defines
// provider as NOT NULL without a default — revisit when auth/registration lands.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String       @id @default(uuid())
  email            String       @unique
  passwordHash     String?
  name             String
  displayName      String
  avatar           String?
  role             UserRole     @default(USER)
  plan             UserPlan     @default(FREE)
  provider         AuthProvider @default(EMAIL)
  providerId       String
  birthDate        DateTime?
  astrologicalSign String?
  mayanKin         String?
  personalArcana   Int?
  emailVerified    DateTime?
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([provider, providerId])
}

enum UserRole {
  USER
  PROFESSIONAL
  ADMIN
}

enum UserPlan {
  FREE
  PLUS
}

enum AuthProvider {
  EMAIL
  GOOGLE
  FACEBOOK
}