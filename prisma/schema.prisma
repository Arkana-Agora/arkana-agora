generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                 @id @default(uuid())
  email                 String                 @unique
  passwordHash          String?
  name                  String
  displayName           String
  avatar                String?
  role                  UserRole               @default(USER)
  plan                  UserPlan               @default(FREE)
  provider              AuthProvider           @default(EMAIL)
  providerId            String
  birthDate             DateTime?
  astrologicalSign      String?
  mayanKin              String?
  personalArcana        Int?
  emailVerified         DateTime?
  isActive              Boolean                @default(true)
  deletedAt             DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  tokenVersion          Int                    @default(0)
  banReason             String?
  bannedAt              DateTime?
  isBanned              Boolean                @default(false)
  maxFollowing          Int                    @default(5000)
  subscriptionTier      UserPlan               @default(FREE)
  sessions              Session[]
  subscription          Subscription?
  profile               UserProfile?
  aiDailyUsage          AIDailyUsage[]
  arcanaCalculations    ArcanaCalculation[]
  commentLikeRewards    CommentLikeReward[]
  commentLikes          CommentLike[]
  commentRewards        CommentReward[]
  comments              Comment[]
  contentReports        ContentReport[]        @relation("ContentReportReporter")
  following             Follow[]               @relation("UserFollowing")
  followers             Follow[]               @relation("UserFollowers")
  giftsSent             Gift[]                 @relation("GiftsSent")
  giftsReceived         Gift[]                 @relation("GiftsReceived")
  horoscopeEntries      HoroscopeEntry[]
  horoscopeLogs         HoroscopeLog[]
  horoscopeNotification HoroscopeNotification?
  interpretations       Interpretation[]
  notifications         Notification[]
  postLikeRewards       PostLikeReward[]
  postLikes             PostLike[]
  posts                 Post[]
  readings              Reading[]

  @@unique([provider, providerId])
}

model UserProfile {
  id              String    @id @default(uuid())
  userId          String    @unique
  bio             String?
  location        String?
  website         String?
  socialLinks     Json?
  skills          String[]  @default([])
  specialties     String[]  @default([])
  rating          Decimal   @default(0) @db.Decimal(3, 2)
  reviewCount     Int       @default(0)
  pricePerReading Decimal?  @db.Decimal(10, 2)
  available       Boolean   @default(true)
  languages       String[]  @default(["pt-BR"])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  username        String?   @unique
  birthPlace      String?
  privacy         Json?
  lastClaimAt     DateTime?
  versosBalance   Int       @default(0)
  versosStreak    Int       @default(0)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id         String             @id @default(uuid())
  userId     String             @unique
  plan       String             @default("PLUS")
  status     SubscriptionStatus
  startDate  DateTime
  endDate    DateTime?
  trialEnd   DateTime?
  externalId String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id                String    @id @default(uuid())
  userId            String
  tokenHash         String    @unique
  familyId          String
  tokenId           String
  replacedByTokenId String?
  revokedAt         DateTime?
  userAgent         String?
  ipAddress         String?
  expiresAt         DateTime
  createdAt         DateTime  @default(now())
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model VerificationToken {
  id         String   @id @default(uuid())
  identifier String
  token      String   @unique
  type       String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

model Reading {
  id              String           @id @default(cuid())
  userId          String
  deckId          String
  spreadId        String
  title           String?
  notes           String?
  seed            String
  duration        Int
  isPublic        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  interpretations Interpretation[]
  cards           ReadingCard[]
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("readings")
}

model ReadingCard {
  id            String  @id @default(cuid())
  readingId     String
  cardId        String
  positionIndex Int
  isReversed    Boolean @default(false)
  reading       Reading @relation(fields: [readingId], references: [id], onDelete: Cascade)

  @@index([readingId])
  @@map("reading_cards")
}

model Interpretation {
  id               String            @id @default(cuid())
  readingId        String
  userId           String
  mode             String
  mood             String?
  question         String?
  content          String
  cacheHash        String            @unique
  modelVersion     String            @default("gpt-4o-2024-08-06")
  tokensUsed       Int               @default(0)
  wasCached        Boolean           @default(false)
  createdAt        DateTime          @default(now())
  followUpMessages FollowUpMessage[]
  reading          Reading           @relation(fields: [readingId], references: [id], onDelete: Cascade)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([readingId])
  @@map("interpretations")
}

model FollowUpMessage {
  id               String         @id @default(cuid())
  interpretationId String
  role             String
  content          String
  createdAt        DateTime       @default(now())
  interpretation   Interpretation @relation(fields: [interpretationId], references: [id], onDelete: Cascade)

  @@index([interpretationId])
  @@map("follow_up_messages")
}

model AIDailyUsage {
  id                  String   @id @default(cuid())
  userId              String
  date                DateTime
  interpretationCount Int      @default(0)
  followUpCount       Int      @default(0)
  createdAt           DateTime @default(now())
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("ai_daily_usage")
}

model ArcanaCalculation {
  id            String   @id @default(uuid())
  userId        String
  birthDate     DateTime
  fullName      String
  reductionDate String
  reductionName String
  arcanaNumber  Int
  arcanaName    String
  description   String   @db.VarChar(2000)
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("arcana_calculations")
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId, createdAt, id])
  @@index([followerId, createdAt, id])
  @@index([followingId, followerId])
  @@map("follows")
}

model FollowReward {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  rewardedAt  DateTime @default(now())

  @@unique([followerId, followingId])
  @@map("follow_rewards")
}

model PostLikeReward {
  id         String   @id @default(cuid())
  postId     String
  userId     String
  rewardedAt DateTime @default(now())
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("post_like_rewards")
}

model CommentLikeReward {
  id         String   @id @default(cuid())
  commentId  String
  userId     String
  rewardedAt DateTime @default(now())
  comment    Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@map("comment_like_rewards")
}

model CommentReward {
  id         String   @id @default(cuid())
  postId     String
  userId     String
  rewardedAt DateTime @default(now())
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("comment_rewards")
}

model Post {
  id               String           @id @default(cuid())
  authorId         String
  type             String
  content          String
  imageUrls        String[]         @default([])
  readingId        String?
  audience         String           @default("public")
  isPinned         Boolean          @default(false)
  likeCount        Int              @default(0)
  commentCount     Int              @default(0)
  commentsDisabled Boolean          @default(false)
  isHidden         Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  commentRewards   CommentReward[]
  comments         Comment[]
  hashtags         PostHashtag[]
  likeRewards      PostLikeReward[]
  likes            PostLike[]
  author           User             @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId, createdAt])
  @@index([createdAt])
  @@map("posts")
}

model Comment {
  id              String              @id @default(cuid())
  postId          String
  authorId        String
  content         String
  parentCommentId String?
  likeCount       Int                 @default(0)
  createdAt       DateTime            @default(now())
  likeRewards     CommentLikeReward[]
  likes           CommentLike[]
  author          User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentComment   Comment?            @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         Comment[]           @relation("CommentReplies")
  post            Post                @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([authorId])
  @@index([parentCommentId])
  @@index([createdAt])
  @@map("comments")
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
  @@index([createdAt])
  @@map("post_likes")
}

model CommentLike {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
  @@map("comment_likes")
}

model PostHashtag {
  id     String @id @default(cuid())
  postId String
  tag    String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([tag])
  @@map("post_hashtags")
}

model Gift {
  id                 String   @id @default(cuid())
  fromUserId         String
  toUserId           String
  giftId             String
  coinCost           Int
  recipientEarnsHalf Boolean  @default(false)
  createdAt          DateTime @default(now())
  fromUser           User     @relation("GiftsSent", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser             User     @relation("GiftsReceived", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([toUserId, createdAt])
  @@index([fromUserId, createdAt])
  @@map("gifts")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  message   String
  data      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

model ContentReport {
  id         String    @id @default(cuid())
  reporterId String
  targetType String
  targetId   String
  reason     String
  status     String    @default("PENDING")
  resolvedAt DateTime?
  resolvedBy String?
  createdAt  DateTime  @default(now())
  reporter   User      @relation("ContentReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
  @@index([reporterId])
  @@map("content_reports")
}

model HoroscopeContent {
  id        String   @id @default(cuid())
  type      String
  signId    String
  element   String?
  period    String
  date      String
  content   Json
  createdAt DateTime @default(now())

  @@unique([type, signId, element, period, date])
  @@index([type, period, date])
  @@map("horoscope_contents")
}

model HoroscopeEntry {
  id        String   @id @default(cuid())
  userId    String
  type      String
  signId    String
  element   String?
  period    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("horoscope_entries")
}

model HoroscopeLog {
  id        String   @id @default(cuid())
  userId    String
  type      String
  signId    String
  element   String?
  period    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("horoscope_logs")
}

model HoroscopeNotification {
  id             String  @id @default(cuid())
  userId         String  @unique
  westernEnabled Boolean @default(true)
  chineseEnabled Boolean @default(false)
  mayaEnabled    Boolean @default(false)
  hour           Int     @default(7)
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("horoscope_notifications")
}

enum UserRole {
  USER
  PROFESSIONAL
  ADMIN
}

enum UserPlan {
  FREE
  PLUS
}

enum AuthProvider {
  EMAIL
  GOOGLE
  FACEBOOK
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  TRIAL
}
