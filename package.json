{
  "name": "arkana-agora",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "dev:ws": "echo \"Socket.io mini-service (port 3003) — not scaffolded yet\"",
    "dev:all": "echo \"Run full local stack (Next.js + Socket.io + Caddy) — not scaffolded yet\"",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "seed": "bunx tsx prisma/seed.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,cjs,js}": [
      "eslint --fix",
      "bunx prettier --write"
    ],
    "*.{json,md,css}": "bunx prettier --write"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "@sentry/nextjs": "^10.71.0",
    "@tailwindcss/postcss": "^4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "next": "^16.0.4",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4",
    "nodemailer": "^9.0.5",
    "pino": "^10.3.1",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.85.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^9.19.0",
    "eslint-config-next": "^16.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "prisma": "^6.5.0",
    "shadcn": "^4.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.5"
  },
  "prisma": {
    "seed": "bunx tsx prisma/seed.ts"
  }
}
