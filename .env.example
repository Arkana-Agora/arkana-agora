# Arkana Agora — env template (names only, no real values)
# Source: docs/02-architecture/deployment.md §2.4 + docs/07-security/security.md
# Copy to .env for local development (Prisma CLI and bun scripts load .env, not .env.local).
# Never commit .env / .env*.local.
# NEVER USE REAL KEYS IN THIS FILE. USE .env.local FOR LOCAL DEVELOPMENT AND ENV VARS IN PRODUCTION.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3003

# Database (dev Docker Postgres 16 — `docker compose up -d postgres`; prod Neon PostgreSQL)
DATABASE_URL=your_postgres_connection_string_here

# Auth (Auth.js v5 — ADR-010)
# AUTH_URL: origem canônica da aplicação (impede host-header poisoning do magic link em prod — definido junto ao AUTH_SECRET)
AUTH_URL=http://localhost:3000
AUTH_SECRET=
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_EMAIL_SKIP_SEND=false
EMAIL_FROM=Arkana Agora <nao-responda@arkanaagora.dev>
# JWT custom RS256 (Sprint 1 — ADR-009)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# AI
AI_PRIMARY_API_KEY=
AI_FALLBACK_API_KEY=

# Mercado Pago (sandbox: TEST- prefix)
MP_ACCESS_TOKEN=
WEBHOOK_SECRET=
MP_WEBHOOK_URL=http://localhost:3000/api/v1/webhooks/mercadopago

# Redis
REDIS_URL=redis://localhost:6379

# Observability
# Sentry: sem DSN o SDK permanece desabilitado (build e runtime não exigem credenciais)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Nível de log do Pino (default: info)
LOG_LEVEL=info
POSTHOG_KEY=

# Cloudflare R2 (S3-compatible, NOT AWS S3)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://your-r2-bucket-name.r2.cloudflarestorage.com

# Push / e-mail
FCM_SERVER_KEY=
# SMTP para magic link (Auth.js EmailProvider); em dev sem SMTP, use AUTH_EMAIL_SKIP_SEND=true (loga o link no console)
SMTP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# CORS
ALLOWED_ORIGINS=