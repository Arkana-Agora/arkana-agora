# Arkana Agora — env template (names only, no real values)
# Source: docs/02-architecture/deployment.md §2.4 + docs/07-security/security.md
# Copy to .env.local for local development. Never commit .env / .env*.local.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3003

# Database (dev SQLite; prod Neon PostgreSQL)
DATABASE_URL=file:./dev.db

# Auth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# AI
AI_PRIMARY_API_KEY=

# Mercado Pago (sandbox: TEST- prefix)
MP_ACCESS_TOKEN=
MP_WEBHOOK_URL=http://localhost:3000/api/payments/webhook

# Redis
REDIS_URL=redis://localhost:6379

# Observability
SENTRY_DSN=
POSTHOG_KEY=

# Cloudflare R2 (S3-compatible, NOT AWS S3)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://assets.arkanaagora.com.br

# Push / e-mail
FCM_SERVER_KEY=
SMTP_HOST=
SMTP_USER=
SMTP_PASS=

# CORS
ALLOWED_ORIGINS=